{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Fox Sphere API",
    "description": "REST API for the Fox Sphere Twitch bot platform"
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "components": {
    "schemas": {
      "Channel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "clx1abc123def"
          },
          "twitchId": {
            "type": "string",
            "example": "12345678"
          },
          "login": {
            "type": "string",
            "example": "luckyfoxcode"
          },
          "displayName": {
            "type": "string",
            "example": "LuckyFoxCode"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "PAUSED",
              "REVOKED"
            ]
          },
          "botIsMod": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "twitchId",
          "login",
          "displayName",
          "status",
          "botIsMod"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "message": {
            "type": "string",
            "example": "Channel not found"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": {
              "id": [
                "Invalid input"
              ]
            }
          }
        },
        "required": [
          "status",
          "message"
        ]
      },
      "CreateChannel": {
        "type": "object",
        "properties": {
          "twitchId": {
            "type": "string",
            "minLength": 1,
            "example": "99200545"
          },
          "login": {
            "type": "string",
            "minLength": 1,
            "example": "luckyfoxcode"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "example": "LuckyFoxCode"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "PAUSED",
              "REVOKED"
            ]
          },
          "botIsMod": {
            "type": "boolean"
          }
        },
        "required": [
          "twitchId",
          "login",
          "displayName"
        ]
      },
      "ChannelList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Channel"
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/channels/{id}": {
      "get": {
        "tags": [
          "Channels"
        ],
        "summary": "Get channel by ID",
        "operationId": "getChannelById",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "clx1abc123def"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Channel found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Channel"
                }
              }
            }
          },
          "400": {
            "description": "Invalid channel id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Channel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/channels": {
      "post": {
        "tags": [
          "Channels"
        ],
        "summary": "Create a channel",
        "operationId": "createChannel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChannel"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Channel created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Channel"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Channel with this twitchId already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Channels"
        ],
        "summary": "List channels",
        "operationId": "listChannels",
        "responses": {
          "200": {
            "description": "All channels",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelList"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
