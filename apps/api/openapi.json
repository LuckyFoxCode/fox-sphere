{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Fox Sphere API",
    "description": "REST API for the Fox Sphere Twitch bot platform"
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "components": {
    "schemas": {
      "SessionMe": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "example": "luckyfoxcode"
          }
        },
        "required": [
          "login"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "message": {
            "type": "string",
            "example": "Channel not found"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": {
              "id": [
                "Invalid input"
              ]
            }
          }
        },
        "required": [
          "status",
          "message"
        ]
      },
      "ChannelList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Channel"
        }
      },
      "Channel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "clx1abc123def"
          },
          "twitchId": {
            "type": "string",
            "example": "12345678"
          },
          "login": {
            "type": "string",
            "example": "luckyfoxcode"
          },
          "displayName": {
            "type": "string",
            "example": "LuckyFoxCode"
          },
          "status": {
            "$ref": "#/components/schemas/ChannelStatus"
          },
          "botIsMod": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "twitchId",
          "login",
          "displayName",
          "status",
          "botIsMod"
        ]
      },
      "ChannelStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "ACTIVE",
          "PAUSED",
          "REVOKED"
        ]
      },
      "CreateChannel": {
        "type": "object",
        "properties": {
          "twitchId": {
            "type": "string",
            "minLength": 1,
            "example": "99200545"
          },
          "login": {
            "type": "string",
            "minLength": 1,
            "example": "luckyfoxcode"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "example": "LuckyFoxCode"
          },
          "status": {
            "$ref": "#/components/schemas/ChannelStatus"
          },
          "botIsMod": {
            "type": "boolean"
          }
        },
        "required": [
          "twitchId",
          "login",
          "displayName"
        ]
      },
      "UpdateChannel": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ChannelStatus"
          },
          "botIsMod": {
            "type": "boolean"
          }
        }
      },
      "PaginatedChannelUsers": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChannelUser"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "perPage": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "perPage"
        ]
      },
      "ChannelUser": {
        "type": "object",
        "properties": {
          "twitchId": {
            "type": "string",
            "example": "12345678"
          },
          "username": {
            "type": "string",
            "example": "luckyfoxcode"
          },
          "coins": {
            "type": "number"
          },
          "lvl": {
            "type": "number"
          },
          "xp": {
            "type": "number"
          },
          "lastXpAt": {
            "type": "string",
            "example": "2026-10-07T12:00:00.000Z"
          },
          "isMod": {
            "type": "boolean"
          },
          "isFounder": {
            "type": "boolean"
          },
          "isSubscriber": {
            "type": "boolean"
          },
          "isPermanentVip": {
            "type": "boolean"
          },
          "spinsCount": {
            "type": "number"
          },
          "totalWin": {
            "type": "number"
          },
          "totalLoss": {
            "type": "number"
          },
          "xpThisWeek": {
            "type": "number"
          },
          "hasTicket": {
            "type": "boolean"
          },
          "isLuckyVip": {
            "type": "boolean"
          }
        },
        "required": [
          "twitchId",
          "username",
          "coins",
          "lvl",
          "xp",
          "lastXpAt",
          "isMod",
          "isFounder",
          "isSubscriber",
          "isPermanentVip",
          "spinsCount",
          "totalWin",
          "totalLoss",
          "xpThisWeek",
          "hasTicket",
          "isLuckyVip"
        ]
      },
      "ChannelLeaderboard": {
        "type": "object",
        "properties": {
          "topCoins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChannelUser"
            }
          },
          "topXp": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChannelUser"
            }
          }
        },
        "required": [
          "topCoins",
          "topXp"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get the currently signed-in admin",
        "operationId": "getSessionMe",
        "responses": {
          "200": {
            "description": "The signed-in admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionMe"
                }
              }
            }
          },
          "401": {
            "description": "No valid session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/channels": {
      "get": {
        "tags": [
          "Channels"
        ],
        "summary": "List channels",
        "operationId": "listChannels",
        "responses": {
          "200": {
            "description": "All channels",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelList"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Channels"
        ],
        "summary": "Create a channel",
        "operationId": "createChannel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChannel"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Channel created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Channel"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Channel with this twitchId already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/channels/{login}": {
      "get": {
        "tags": [
          "Channels"
        ],
        "summary": "Get channel by login",
        "operationId": "getChannelById",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "luckyfoxcode"
            },
            "required": true,
            "name": "login",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Channel found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Channel"
                }
              }
            }
          },
          "400": {
            "description": "Invalid channel login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Channel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Channels"
        ],
        "summary": "Update a channel",
        "operationId": "patchChannel",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "luckyfoxcode"
            },
            "required": true,
            "name": "login",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateChannel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Channel updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Channel"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Channel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Channels"
        ],
        "summary": "Delete a channel",
        "operationId": "deleteChannel",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "luckyfoxcode"
            },
            "required": true,
            "name": "login",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Channel deleted"
          },
          "404": {
            "description": "Channel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/channels/{login}/viewers": {
      "get": {
        "tags": [
          "ChannelUsers"
        ],
        "summary": "List a channel's viewers",
        "operationId": "listChannelUsers",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "luckyfoxcode"
            },
            "required": true,
            "name": "login",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "required": false,
            "name": "perPage",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Page of viewers; empty when the channel has none",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedChannelUsers"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Channel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/channels/{login}/leaderboard": {
      "get": {
        "tags": [
          "ChannelUsers"
        ],
        "summary": "Get a channel's coin and xp leaderboards",
        "operationId": "getChannelLeaderboard",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "luckyfoxcode"
            },
            "required": true,
            "name": "login",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Top viewers by coins and by xp",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelLeaderboard"
                }
              }
            }
          },
          "400": {
            "description": "Invalid limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Channel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/channels/{login}/viewers/{twitchId}": {
      "get": {
        "tags": [
          "ChannelUsers"
        ],
        "summary": "Get one viewer of a channel",
        "operationId": "getChannelUser",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "login",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "twitchId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Viewer found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelUser"
                }
              }
            }
          },
          "400": {
            "description": "Invalid login or twitchId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Channel or viewer not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
