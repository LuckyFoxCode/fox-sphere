{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Fox Sphere API",
    "description": "REST API for the Fox Sphere Twitch bot platform"
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "components": {
    "schemas": {
      "Channel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "clx1abc123def"
          },
          "twitchId": {
            "type": "string",
            "example": "12345678"
          },
          "login": {
            "type": "string",
            "example": "luckyfoxcode"
          },
          "displayName": {
            "type": "string",
            "example": "LuckyFoxCode"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "PAUSED",
              "REVOKED"
            ]
          },
          "botIsMod": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "twitchId",
          "login",
          "displayName",
          "status",
          "botIsMod"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/channels/{id}": {
      "get": {
        "tags": [
          "Channels"
        ],
        "summary": "Get channel by ID",
        "operationId": "getChannelById",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "clx1abc123def"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Channel found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Channel"
                }
              }
            }
          },
          "404": {
            "description": "Channel not found"
          }
        }
      }
    }
  }
}
