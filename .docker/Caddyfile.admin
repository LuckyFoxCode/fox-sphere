# Admin panel edge. Plain HTTP on :80 - the site address is written out rather than taken from
# {$SITE_ADDRESS}, as .docker/Caddyfile does, because there is no domain here and nothing to
# gain from an env var: this image is reached through an SSH tunnel and compose publishes the
# host port. Caddy defaults to :80 for an empty site address, but naming it keeps the listening
# port and the image's EXPOSE 80 one fact instead of two that can drift.
#
#   ssh -L 5174:localhost:5174 <vm>    # then open http://localhost:5174
#
# The proxy target is the backend container on the compose network: `admin-api` is the service
# name and 3001 is ENV API_PORT in .docker/admin.Dockerfile.

:80 {
	encode gzip

	# `route` preserves this order, which is the whole reason it is here. A bare chain of
	# `handle` blocks is sorted by Caddy rather than read in the order written.
	route {
		# This 404 is the FIRST lock on the door, and the only one that matters at the edge.
		# apps/api does mount Swagger again - behind requireSession, so an unauthenticated
		# request would get a JSON 401 - but this rule means the deployed panel never asks:
		# only /api/* is proxied, so /docs never reaches the backend by any path. A rule whose
		# safety rests on some future `handle` not existing is not a rule, so it is written
		# down rather than inferred from the routing above. Keep it first.
		#
		# One glob token per rule, not a bare `/docs`: a path matcher is an exact match by
		# default, so `/docs` missed `/docs/` - the form `app.use("/docs", ...)` serves - which
		# then fell through to the SPA below and answered it with index.html. AGENTS.md states
		# the 404 unconditionally, so the rule has to cover what it claims. It is a glob rather
		# than the narrower `/docs` + `/docs/*` pair because `handle` takes exactly one matcher
		# token and that pair does not parse. The trailing `*` also matches `/docsSomething`;
		# nothing in the panel is routed there.
		handle /docs* {
			respond 404
		}
		handle /openapi.json* {
			respond 404
		}

		# The panel's API, same-origin: this replaces Vite's dev proxy
		# (apps/admin/vite.config.ts) in production, so every call is first-party and no CORS
		# decision is involved. That is a claim about the requests, not about fx_session being
		# storable: shared/auth/session.ts marks the cookie `secure` when
		# NODE_ENV=production, which the backend image sets, while this edge is plain HTTP, so
		# the browser accepts it only under its potentially-trustworthy-origin exemption for
		# localhost (Chrome and Firefox; historically inconsistent in WebKit). Give this edge a
		# hostname instead of an SSH tunnel and that exemption is gone - the cookie is then
		# never set. reverse_proxy upgrades WebSockets automatically, though apps/api is HTTP
		# only and has no socket server.
		handle /api/* {
			reverse_proxy admin-api:3001
		}

		# Everything else: the Vue SPA. try_files falls back to /index.html so client-side
		# routes survive a refresh and a deep link.
		handle {
			root * /srv
			try_files {path} /index.html
			file_server
		}
	}
}
