generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int           @id @default(autoincrement())
  twitchId       String        @unique
  username       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  coins          Int           @default(0)
  lvl            Int           @default(1)
  xp             Int           @default(0)
  lastXpAt       DateTime      @default(now())
  isMod          Boolean       @default(false)
  isFounder      Boolean       @default(false)
  isSubscriber   Boolean       @default(false)
  isPermanentVip Boolean       @default(false)
  spinsCount     Int           @default(0)
  totalWin       Int           @default(0)
  totalLoss      Int           @default(0)
  coinHistories  CoinHistory[]
  lotteryContext UserLottery?
  pokemon        UserPokemon?
  xpHistories    XpHistory[]
  watchStreaks   WatchStreak[]
}

model UserPokemon {
  id              Int      @id @default(autoincrement())
  pokemonId       Int
  speciesName     String
  spriteUrl       String
  lvl             Int      @default(1)
  xp              Int      @default(1)
  evolutionStage  Int      @default(1)
  isReadyToEvolve Boolean  @default(false)
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model UserLottery {
  id         Int     @id @default(autoincrement())
  xpThisWeek Int     @default(0)
  hasTicket  Boolean @default(false)
  isLuckyVip Boolean @default(false)
  userId     Int     @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum HistoryReason {
  BOSS_REWARD
  GIFT
  LOTTERY
  CHANGE_POINTS
  WATCH_STREAK
}

model CoinHistory {
  id        Int           @id @default(autoincrement())
  amount    Int
  reason    HistoryReason
  details   String?
  createdAt DateTime      @default(now())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model XpHistory {
  id        Int           @id @default(autoincrement())
  userId    Int
  amount    Int
  reason    HistoryReason
  details   String?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WatchStreak {
  id          Int      @id @default(autoincrement())
  userId      Int
  streakValue Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, streakValue])
}

model SystemState {
  id                Int       @id @default(1)
  streamLevel       Int       @default(1)
  streamCurrentXp   Int       @default(0)
  updatedAt         DateTime  @updatedAt
  xpBoostMultiplier Int       @default(1)
  xpBoostExpiresAt  DateTime?
}

enum ChannelStatus {
  PENDING
  ACTIVE
  PAUSED
  REVOKED
}

model Channel {
  id          String        @id @default(cuid())
  twitchId    String        @unique
  login       String
  displayName String
  status      ChannelStatus @default(PENDING)
  botIsMod    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model TwitchToken {
  id                  String
  twitchUserId        String   @unique
  accessToken         String
  refreshToken        String
  expiresIn           Int      @default(0)
  obtainmentTimestamp BigInt
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("twitch_tokens")
}
