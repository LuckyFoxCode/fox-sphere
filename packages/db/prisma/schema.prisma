generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int           @id @default(autoincrement())
  twitchId       String        @unique
  username       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  coins          Int           @default(0)
  lvl            Int           @default(1)
  xp             Int           @default(0)
  lastXpAt       DateTime      @default(now())
  isMod          Boolean       @default(false)
  isFounder      Boolean       @default(false)
  isSubscriber   Boolean       @default(false)
  isPermanentVip Boolean       @default(false)
  spinsCount     Int           @default(0)
  totalWin       Int           @default(0)
  totalLoss      Int           @default(0)
  coinHistories  CoinHistory[]
  lotteryContext UserLottery?
  hero           UserHero?
  xpHistories    XpHistory[]
  watchStreaks   WatchStreak[]
}

model UserHero {
  id        Int      @id @default(autoincrement())
  heroId    String
  userId    Int      @unique
  level     Int      @default(1)
  xp        Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserLottery {
  id         Int     @id @default(autoincrement())
  xpThisWeek Int     @default(0)
  hasTicket  Boolean @default(false)
  isLuckyVip Boolean @default(false)
  userId     Int     @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum HistoryReason {
  BOSS_REWARD
  GIFT
  LOTTERY
  CHANGE_POINTS
  WATCH_STREAK
  SPIN
  SPIN_PRIZE
  JACKPOT
  FISH
}

model CoinHistory {
  id        Int           @id @default(autoincrement())
  amount    Int
  reason    HistoryReason
  details   String?
  redemptionId String?   @unique
  createdAt DateTime      @default(now())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model XpHistory {
  id        Int           @id @default(autoincrement())
  userId    Int
  amount    Int
  reason    HistoryReason
  details   String?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WatchStreak {
  id          Int      @id @default(autoincrement())
  userId      Int
  streakValue Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, streakValue])
}

model SystemState {
  id                Int       @id @default(1)
  streamLevel       Int       @default(1)
  streamCurrentXp   Int       @default(0)
  jackpotTotal      Int       @default(1000)
  updatedAt         DateTime  @updatedAt
  xpBoostMultiplier Int       @default(1)
  xpBoostExpiresAt  DateTime?
}

enum ChannelStatus {
  PENDING
  ACTIVE
  PAUSED
  REVOKED
}

model Channel {
  id          String        @id @default(cuid())
  twitchId    String        @unique
  login       String        @unique
  displayName String
  status      ChannelStatus @default(PENDING)
  botIsMod    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  users       ChannelUser[]
}

model TwitchToken {
  id                  String
  twitchUserId        String   @unique
  accessToken         String
  refreshToken        String
  expiresIn           Int      @default(0)
  obtainmentTimestamp BigInt
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("twitch_tokens")
}

// Личность зрителя, без баланса: баланс принадлежит паре (канал, зритель) и живёт
// в `ChannelUser`. Релиз A только копирует данные из legacy `User` / `UserLottery` —
// миграция чисто аддитивная, ни одного `DROP`; legacy-таблицы уходят отдельно.
model Viewer {
  id        String   @id @default(cuid())
  twitchId  String   @unique
  username  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channelUsers ChannelUser[]
}

// `id` — `Int`, а не `cuid`, потому что настоящий ключ пары — это
// `@@unique([channelId, viewerId])`, обе колонки уже строковые; суррогатный ключ
// тут ничего не различает, а лидерборды сортируются по (`xp`, `coins`) внутри канала.
model ChannelUser {
  id             Int      @id @default(autoincrement())
  channelId      String
  viewerId       String
  coins          Int      @default(0)
  lvl            Int      @default(1)
  xp             Int      @default(0)
  lastXpAt       DateTime @default(now())
  isMod          Boolean  @default(false)
  isFounder      Boolean  @default(false)
  isSubscriber   Boolean  @default(false)
  isPermanentVip Boolean  @default(false)
  spinsCount     Int      @default(0)
  totalWin       Int      @default(0)
  totalLoss      Int      @default(0)
  xpThisWeek     Int      @default(0)
  hasTicket      Boolean  @default(false)
  isLuckyVip     Boolean  @default(false)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  viewer  Viewer  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([channelId, viewerId])
  @@index([channelId, xp])
  @@index([channelId, coins])
}
