# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
PORT=3000
NODE_ENV=development
DEBUG=true
COMMAND_PREFIX=!t

# Allowed origin for Socket.io and Express CORS (your Vue 3 Vite dev server)
ALLOWED_ORIGIN="http://localhost:5173"

# Database connection string for Prisma ORM
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ==============================================================================
# TWITCH DEVELOPER APPLICATION (Twitch Console)
# ==============================================================================
# Single Client ID and Secret shared by both Streamer and Bot accounts
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# --- Admin panel. None of these is a Twitch Console credential, and only apps/api acts on
# --- them - but bot-runtime evaluates ADMIN_TWITCH_USER_ID too, because config is one shared
# --- object and reads every key at import. -----------------------------------------------------
# Twitch user id allowed into the admin panel. NOT the same as TWITCH_USER_ID below: that one
# is the broadcaster the bot runs as, and in a multi-tenant world the two stop being equal.
# Of the three here it is the only one read with getEnv, so an absent or empty value throws
# there and stops the bot from starting - not just apps/api.
ADMIN_TWITCH_USER_ID=99200545

# HMAC key for the session cookie. Generate separately from any old key:
#   openssl rand -hex 32
# The value shipped below is a PLACEHOLDER, not a secret. It is published in git, and a
# session cookie is verified against this HMAC alone - never against the Twitch user id - so
# anyone who has read this file can mint one the panel accepts. Replace it before exposing
# anything. Leaving the variable empty is the fail-closed case: every /api data route 500s
# with "ADMIN_SESSION_SECRET is not set". The placeholder does NOT - it passes that check and
# hands out working sessions keyed by a published string. (/health, /docs, /openapi.json and
# the OAuth login/logout redirects sit above that guard and keep answering either way; the
# callback is above it too, but still fails, because it cannot sign a cookie with no secret.)
ADMIN_SESSION_SECRET=change_me_generate_with_openssl

# Must match a registered redirect URL in the Twitch console byte for byte. In dev the browser
# only ever sees the Vite port (:5174), because /api is proxied - registering :3001 fails.
ADMIN_OAUTH_REDIRECT_URI=http://localhost:5174/api/auth/twitch/callback

# ==============================================================================
# TWITCH STREAMER (BROADCASTER) ACCOUNT
# ==============================================================================
# Twitch User ID for 'luckyfoxcode'
TWITCH_USER_ID=99200545
TWITCH_CHANNEL_NAME=luckyfoxcode

# Tokens generated with required scopes (e.g., channel:manage:vips, moderation:read)
TWITCH_STREAMER_ACCESS_TOKEN=your_streamer_access_token
TWITCH_STREAMER_REFRESH_TOKEN=your_streamer_refresh_token

# ==============================================================================
# TWITCH BOT ACCOUNT
# ==============================================================================
# Twitch User ID for the bot account
TWITCH_BOT_ID=1502579014

# Tokens generated for the bot account (e.g., chat:read, chat:edit)
TWITCH_BOT_ACCESS_TOKEN=your_bot_access_token
TWITCH_BOT_REFRESH_TOKEN=your_bot_refresh_token