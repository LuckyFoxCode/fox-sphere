# Copy to `.env.prod` ON THE VM (never commit it). Compose reads it for `backend`.
# ==============================================================================
# EDGE / NETWORKING
# ==============================================================================
# ":80" = plain HTTP on the raw Oracle IP (start here).
# Later: set to the domain (e.g. overlay.luckyfox.dev) for automatic HTTPS.
SITE_ADDRESS=:80

# Where the overlay connects FROM = the Socket.io CORS allow-list.
# Option B (overlay served by the VM, same-origin): the site URL.
#   IP now:   http://<ORACLE_PUBLIC_IP>
#   Domain:   https://overlay.example.com
# Option A (overlay on Cloudflare Pages): the Pages URL.
ALLOWED_ORIGIN=http://CHANGE_ME

# Admin panel - DEPLOYED as of this release, in its own compose project `foxsphere-admin`
# (docker-compose.admin.yml, rolled out by deploy-admin.yml). That stack reads the SAME file
# the bot reads, ~/foxsphere/.env, and there is deliberately no admin-only env file: `config`
# builds itself at import and throws on the first missing key, so apps/api needs the whole
# TWITCH_* set below even though it never uses most of them. A second file would be a second
# copy of the same secrets, not a smaller exposure.
#
# The panel has no public address and gets none until a second streamer needs it: compose
# publishes 127.0.0.1:5174 and nothing else, and you reach it through a tunnel -
#   ssh -L 5174:localhost:5174 <vm>     # then open http://localhost:5174
# ADMIN_OAUTH_REDIRECT_URI is therefore the tunnel's address, and NOT SITE_ADDRESS:
#   http://localhost:5174/api/auth/twitch/callback
# Twitch accepts http://localhost as a redirect URI, which is what makes an SSH tunnel a
# workable deployment for an operator console. It must be byte-identical to a redirect URL
# registered in the Twitch console, scheme and port included.
#
# All three are read by apps/api alone, with process.env rather than getEnv (see AGENTS.md),
# so an absent value costs you the panel and never the bot. That distinction is not academic:
# v1.15.0 shipped ADMIN_TWITCH_USER_ID on getEnv, and the bot's deploy died on the missing
# variable under `set -e`, after the images were built and before `docker compose up -d`.
# Still replace every CHANGE_ME: apps/api compares each logged-in Twitch id against
# ADMIN_TWITCH_USER_ID, and a literal CHANGE_ME matches no account, so every login is refused
# as "This Twitch account is not an admin" with nothing erroring. And generate the session
# secret - `openssl rand -hex 32` - because the shipped placeholder does not trip the guard: it
# passes, and hands out sessions keyed by a string published in git. That key signs the
# fx_session cookie, which is full database access.
ADMIN_TWITCH_USER_ID=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
ADMIN_OAUTH_REDIRECT_URI=CHANGE_ME

# ==============================================================================
# POSTGRES (compose creates this DB; DATABASE_URL is derived in compose)
# ==============================================================================
POSTGRES_USER=fox_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=foxsphere_db

# ==============================================================================
# APP
# ==============================================================================
PORT=3000
NODE_ENV=production
DEBUG=false
COMMAND_PREFIX=!t

# ==============================================================================
# TWITCH (same values as apps/backend/.env — see .env.example)
# ==============================================================================
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

TWITCH_USER_ID=99200545
TWITCH_CHANNEL_NAME=luckyfoxcode
TWITCH_STREAMER_ACCESS_TOKEN=your_streamer_access_token
TWITCH_STREAMER_REFRESH_TOKEN=your_streamer_refresh_token

TWITCH_BOT_ID=1502579014
TWITCH_BOT_ACCESS_TOKEN=your_bot_access_token
TWITCH_BOT_REFRESH_TOKEN=your_bot_refresh_token
